# ---- Server ----
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brokerverse
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/brokerverse_test
# Production refuses to start unless this is a random value of 32+ characters
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h
# Comma-separated web origins; "*" is only accepted outside production
CORS_ORIGIN=http://localhost:5173
MAIL_FROM=no-reply@brokerverse.local
# Seed the twelve demo personas and reference data on start (never in a real production database)
SEED_DEMO=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=300
TRUST_PROXY=false

# ---- Docker compose overrides ----
# POSTGRES_PASSWORD=postgres
# WEB_PORT=8080
